---
import Layout from '../layouts/Layout.astro';

const attorneys = [
  {
    name: "Michael Baim",
    title: "Managing Partner",
    bio: "Michael leads the firm with a focus on strategic litigation and client-centric solutions. His extensive experience in creditors' rights ensures clients receive knowledgeable and effective representation.",
    image: "/images/placeholders/attorney-headshot-baim.jpg",
    alt: "Headshot of Michael Baim, Managing Partner"
  },
  {
    name: "Patricia Lepak",
    title: "Chief Compliance Officer",
    bio: "Patricia oversees the firm's compliance with all state and federal regulations. Her meticulous approach to legal ethics and procedure provides a critical foundation for our practice.",
    image: "/images/placeholders/attorney-headshot-lepak.jpg",
    alt: "Headshot of Patricia Lepak, Chief Compliance Officer"
  },
  {
    name: "Brian Berlin",
    title: "Senior Trial Attorney",
    bio: "Brian is a formidable advocate in the courtroom, specializing in complex commercial litigation. He has a strong record of securing favorable judgments for our clients.",
    image: "/images/placeholders/attorney-headshot-berlin.jpg",
    alt: "Headshot of Brian Berlin, Senior Trial Attorney"
  }
];

const seo = {
  title: "Meet Our Attorneys | The CKB Firm",
  description: "Meet the experienced legal team at The CKB Firm, including Michael Baim, Patricia Lepak, and Brian Berlin. Dedicated creditors' rights attorneys in Chicago."
};
---

<Layout title={seo.title} description={seo.description}>
  <main id="main-content">
    <section class="attorneys-intro">
      <div class="container">
        <h1>An Experienced Team on Your Side</h1>
        <p>Our firm is led by a team of dedicated attorneys with a proven track record of success in commercial litigation and creditors' rights. We are committed to providing the highest level of service and legal expertise.</p>
      </div>
    </section>

    <section class="attorneys-grid-section">
      <div class="container">
        <div class="profile-card-grid-3">
          {attorneys.map(attorney => (
            <article class="profile-card">
              <img src={attorney.image} alt={attorney.alt} class="profile-card-img" loading="lazy" width="300" height="300" />
              <div class="profile-card-content">
                <h2 class="profile-card-name">{attorney.name}</h2>
                <p class="profile-card-title">{attorney.title}</p>
                <p class="profile-card-bio">{attorney.bio}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .attorneys-intro {
    padding: 4rem 0 2rem;
    text-align: center;
    background-color: var(--color-background);
  }

  .attorneys-intro h1 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .attorneys-intro p {
    max-width: 70ch;
    margin-left: auto;
    margin-right: auto;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .attorneys-grid-section {
    padding: 3rem 0 5rem;
  }

  .profile-card-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .profile-card {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    text-align: center;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .profile-card:hover,
  .profile-card:focus-within {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .profile-card-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .profile-card-content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .profile-card-name {
    color: var(--color-primary);
    font-size: 1.5rem;
    margin: 0 0 0.25rem;
  }

  .profile-card-title {
    color: var(--color-accent);
    font-weight: bold;
    margin: 0 0 1rem;
    text-transform: uppercase;
    font-size: 0.875rem;
    letter-spacing: 0.5px;
  }

  .profile-card-bio {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Responsive Styles */
  @media (max-width: 992px) {
    .profile-card-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .attorneys-intro {
      padding: 3rem 0 1rem;
    }

    .attorneys-grid-section {
      padding: 2rem 0 3rem;
    }

    .profile-card-grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>