---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Contact The CKB Firm | Chicago Creditors' Rights Lawyers";
const pageDescription = "Contact The CKB Firm for a consultation. Our office is located at 30 N. LaSalle St., Chicago, IL. Call us today to discuss your legal needs.";
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="contact-section">
    <div class="container">
      <header class="page-header">
        <h1>Contact Us</h1>
      </header>
      <div class="two-column-layout">
        <article class="text-column">
          <h2>Get In Touch</h2>
          <p>
            Reach out to our team to discuss your legal needs. We are ready to assist you with your commercial litigation and creditors' rights matters.
          </p>
          <address>
            <strong>Address:</strong><br>
            30 N. LaSalle St., Suite 1520<br>
            Chicago, IL 60602<br><br>
            <strong>Phone:</strong><br>
            <a href="tel:+13125550100">(312) 555-0100</a><br><br>
            <strong>Email:</strong><br>
            <a href="mailto:info@ckbfirm.com">info@ckbfirm.com</a>
          </address>
        </article>
        <aside class="map-column">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2970.333318210165!2d-87.6349996845586!3d41.88579697922185!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x880e2cbf5a8a2309%3A0x8f3c7a7a6a4e353a!2s30%20N%20LaSalle%20St%2C%20Chicago%2C%20IL%2060602!5e0!3m2!1sen!2sus!4v1678886400000"
            width="600"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map showing location of The CKB Firm at 30 N. LaSalle St., Chicago, IL">
          </iframe>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-section {
    padding: 4rem 1.5rem;
    background-color: var(--color-background, #F2F2F2);
    color: var(--color-text, #333333);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 2.75rem;
    color: var(--color-primary, #3D4C5C);
    font-weight: 700;
  }

  .two-column-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: start;
  }

  .text-column h2 {
    font-size: 2.25rem;
    color: var(--color-primary, #3D4C5C);
    margin-bottom: 1.5rem;
  }

  .text-column p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-secondary, #666666);
    margin-bottom: 2rem;
  }

  .text-column address {
    font-style: normal;
    line-height: 1.8;
    font-size: 1.1rem;
    color: var(--color-secondary, #666666);
  }

  .text-column strong {
    color: var(--color-text, #333333);
    font-weight: 600;
  }

  .text-column a {
    color: var(--color-accent, #CB333B);
    text-decoration: none;
    transition: opacity 0.2s ease-in-out;
  }

  .text-column a:hover,
  .text-column a:focus {
    text-decoration: underline;
    opacity: 0.8;
  }

  .map-column iframe {
    width: 100%;
    height: 450px;
    border: 1px solid #ddd;
    border-radius: 4px;
  }

  /* Responsive styles */
  @media (max-width: 992px) {
    .two-column-layout {
      grid-template-columns: 1fr;
    }

    .map-column {
      margin-top: 2rem;
    }
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: 3rem 1rem;
    }

    h1 {
      font-size: 2.25rem;
    }

    .text-column h2 {
      font-size: 1.8rem;
    }
  }
</style>