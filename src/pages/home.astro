---
// Import a layout component if you have one, e.g., for header, footer, and basic SEO.
// import Layout from '../layouts/Layout.astro';

// SEO Data
const title = "The CKB Firm | Creditors' Rights & Collections Attorneys in Chicago, IL";
const description = "Experienced Chicago attorneys specializing in creditors' rights, commercial litigation, and business debt collection. The CKB Firm serves clients throughout Cook, Lake, and DuPage counties.";

// Placeholder data for dynamic sections
const practiceAreas = [
  {
    title: "Commercial Litigation",
    description: "Handling complex business disputes, breach of contract claims, and counterclaim defense to protect your interests.",
    link: "/practice-areas#commercial-litigation"
  },
  {
    title: "Creditors' Rights",
    description: "Assisting with pre-suit matters, litigation, and effective post-judgment collections to recover what you are owed.",
    link: "/practice-areas#creditors-rights"
  },
  {
    title: "Real Estate Law",
    description: "Managing commercial and residential real estate closings with precision, ensuring smooth and secure transactions.",
    link: "/practice-areas#real-estate"
  }
];

const attorneys = [
  {
    name: "Michael S. Baim",
    title: "Managing Partner",
    image: "/images/placeholders/attorney-michael-baim.jpg",
    link: "/attorneys/michael-baim"
  },
  {
    name: "Patricia A. Lepak",
    title: "Chief Compliance Officer",
    image: "/images/placeholders/attorney-patricia-lepak.jpg",
    link: "/attorneys/patricia-lepak"
  },
  {
    name: "Brian C. Berlin",
    title: "Attorney",
    image: "/images/placeholders/attorney-brian-berlin.jpg",
    link: "/attorneys/brian-berlin"
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={Astro.url}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="/images/placeholders/og-image.jpg">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content={Astro.url}>
    <meta property="twitter:title" content={title}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content="/images/placeholders/og-image.jpg">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Assuming a global.css file is linked in a base layout or here -->
    <!-- <link rel="stylesheet" href="/styles/global.css"> -->
</head>
<body>
    <!-- Assuming a Header component would be here -->
    <!-- <Header /> -->

    <main>
        <!-- 1. Hero Section -->
        <section class="hero" style="background-image: url('/images/placeholders/hero-image-chicago.jpg');">
            <div class="hero-overlay"></div>
            <div class="container single-column-centered">
                <h1 class="hero-heading">Protecting Your Rights, Recovering Your Assets</h1>
                <p class="hero-body">Providing steadfast legal representation for creditors in commercial litigation and debt recovery throughout the Chicago area.</p>
                <a href="/practice-areas" class="cta-button">Explore Our Services</a>
            </div>
        </section>

        <!-- 2. Firm Introduction Section -->
        <section class="introduction section-padding">
            <div class="container two-column">
                <div class="text-content">
                    <h2 class="section-heading">Your Trusted Partner in Commercial Collections</h2>
                    <p>The CKB Firm is a Chicago-based law firm dedicated to the assertive representation of creditors. With a focused practice in commercial litigation, creditors' rights, and real estate law, we represent a diverse clientele, from publicly traded corporations to privately held businesses. Our experienced attorneys are committed to delivering results and protecting our clients' financial interests.</p>
                    <a href="/about" class="cta-button-secondary">Learn More About Us</a>
                </div>
                <div class="image-content">
                    <img src="/images/placeholders/logo-main.jpg" alt="The CKB Firm Logo" loading="lazy">
                </div>
            </div>
        </section>

        <!-- 3. Practice Areas Overview Section -->
        <section class="practice-areas section-padding" style="background-color: var(--color-background);">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-heading">Our Core Legal Services</h2>
                    <p>Our firm provides comprehensive legal services across several key areas to effectively serve the needs of our clients.</p>
                </div>
                <div class="three-column-grid">
                    {practiceAreas.map(area => (
                        <div class="card">
                            <h3>{area.title}</h3>
                            <p>{area.description}</p>
                            <a href={area.link} class="card-link">Learn More</a>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 4. Meet the Team Section -->
        <section class="team section-padding">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-heading">Our Experienced Attorneys</h2>
                    <p>Our firm is led by a team of dedicated and experienced attorneys, each bringing a wealth of knowledge in creditors' rights and commercial law.</p>
                </div>
                <div class="three-column-grid">
                    {attorneys.map(attorney => (
                        <div class="attorney-card">
                            <img src={attorney.image} alt={`Portrait of ${attorney.name}`} class="attorney-image" loading="lazy">
                            <h3>{attorney.name}</h3>
                            <p class="attorney-title">{attorney.title}</p>
                            <a href={attorney.link} class="card-link">View Profile</a>
                        </div>
                    ))}
                </div>
                <div class="section-footer">
                    <a href="/attorneys" class="cta-button">View All Attorneys</a>
                </div>
            </div>
        </section>
    </main>

    <!-- Assuming a Footer component would be here -->
    <!-- <Footer /> -->
</body>
</html>

<style>
    /* Basic Styles & Variables (assuming these are in global.css) */
    :root {
        --color-primary: #3D4C5C;
        --color-secondary: #666666;
        --color-accent: #CB333B;
        --color-background: #F2F2F2;
        --color-text: #333333;
        --color-white: #FFFFFF;
        --font-family-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --font-family-serif: "Georgia", "Times New Roman", serif;
    }

    body {
        font-family: var(--font-family-sans);
        color: var(--color-text);
        margin: 0;
        line-height: 1.6;
    }

    .container {
        width: 90%;
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-padding {
        padding: 4rem 0;
    }

    .section-heading {
        color: var(--color-primary);
        font-family: var(--font-family-serif);
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .section-header {
        text-align: center;
        margin-bottom: 3rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }
    
    .section-header p {
        font-size: 1.1rem;
        color: var(--color-secondary);
    }

    .section-footer {
        text-align: center;
        margin-top: 3rem;
    }

    /* CTA Button Styles */
    .cta-button, .cta-button-secondary {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        text-decoration: none;
        font-weight: bold;
        border-radius: 4px;
        transition: background-color 0.3s ease, color 0.3s ease;
        text-align: center;
    }

    .cta-button {
        background-color: var(--color-accent);
        color: var(--color-white);
    }

    .cta-button:hover, .cta-button:focus {
        background-color: #a92a30; /* Darker accent */
    }

    .cta-button-secondary {
        background-color: var(--color-primary);
        color: var(--color-white);
    }

    .cta-button-secondary:hover, .cta-button-secondary:focus {
        background-color: #2c3845; /* Darker primary */
    }

    /* 1. Hero Section */
    .hero {
        position: relative;
        color: var(--color-white);
        text-align: center;
        padding: 6rem 0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.6);
        z-index: 1;
    }

    .hero .container {
        position: relative;
        z-index: 2;
    }

    .hero-heading {
        font-family: var(--font-family-serif);
        font-size: 3.5rem;
        margin-bottom: 1rem;
    }

    .hero-body {
        font-size: 1.25rem;
        max-width: 700px;
        margin: 0 auto 2rem;
    }

    /* 2. Introduction Section */
    .introduction .two-column {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
    }

    .introduction .image-content {
        text-align: center;
    }

    .introduction .image-content img {
        max-width: 100%;
        height: auto;
        max-height: 250px;
    }

    /* 3 & 4. Grid Layouts */
    .three-column-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .card, .attorney-card {
        background-color: var(--color-white);
        padding: 2rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        text-align: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .card h3, .attorney-card h3 {
        color: var(--color-primary);
        margin-top: 0;
    }

    .card-link {
        color: var(--color-accent);
        text-decoration: none;
        font-weight: bold;
    }

    .card-link:hover, .card-link:focus {
        text-decoration: underline;
    }

    .attorney-image {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 1rem;
        border: 3px solid var(--color-background);
    }

    .attorney-title {
        color: var(--color-secondary);
        font-style: italic;
    }

    /* Responsive Design */
    @media (max-width: 992px) {
        .section-heading {
            font-size: 2rem;
        }
        .hero-heading {
            font-size: 2.5rem;
        }
        .three-column-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 768px) {
        .section-padding {
            padding: 3rem 0;
        }
        .introduction .two-column {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .introduction .image-content {
            margin-top: 2rem;
        }
        .three-column-grid {
            grid-template-columns: 1fr;
        }
    }
</style>