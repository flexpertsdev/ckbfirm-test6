---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Creditors' Rights & Commercial Collection Law Firm | The CKB Firm" 
  description="The CKB Firm is a Chicago-based law firm specializing in creditors' rights, commercial litigation, and debt collection. We protect your business interests."
>
  <main>
    <!-- 1. Hero Section -->
    <section class="hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <h1 class="hero-heading">Protecting Your Business Interests. Maximizing Your Recovery.</h1>
          <p class="hero-body">
            We are a Chicago-based law firm dedicated to providing exceptional legal collection services. We deliver effective, tailored legal strategies that recover assets and protect your bottom line.
          </p>
          <a href="/practice-areas.html" class="button button-primary">Explore Our Services</a>
        </div>
        <div class="hero-image-wrapper">
          <img 
            src="/images/placeholders/hero-image-chicago.jpg" 
            alt="The Chicago skyline representing The CKB Firm's base of operations."
            class="hero-image"
            width="600"
            height="450"
          />
        </div>
      </div>
    </section>

    <!-- 2. Value Proposition Section -->
    <section class="value-prop-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Dedicated Representation for Your Business</h2>
          <p class="section-subheading">
            Our firm is built on a foundation of experience, technological efficiency, and a deep commitment to our clients' success.
          </p>
        </div>
        <div class="three-column-grid">
          <div class="column-item">
            <h3>Decades of Experience</h3>
            <p>Our attorneys bring a wealth of knowledge in commercial law and creditors' rights, providing seasoned guidance through every stage of the legal process.</p>
          </div>
          <div class="column-item">
            <h3>Technology-Driven Approach</h3>
            <p>We leverage the latest legal technology and law office automation to provide efficient, value-added services and keep you informed on the status of your cases.</p>
          </div>
          <div class="column-item">
            <h3>Client-Focused Strategy</h3>
            <p>Your success is our primary goal. We build strong, transparent relationships and tailor our representation to meet the unique needs and objectives of your business.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Practice Areas Overview Section -->
    <section class="practice-areas-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Our Areas of Practice</h2>
          <p class="section-subheading">
            Our attorneys possess extensive experience in all facets of the collection and litigation process, serving a diverse client base from banks and financial institutions to manufacturers and distributors.
          </p>
        </div>
        <div class="card-grid">
          <div class="card">
            <h3 class="card-title">Commercial Litigation</h3>
            <p class="card-body">Aggressively representing your interests in breach of contract disputes, business torts, and other complex commercial matters in and out of the courtroom.</p>
            <a href="/practice-areas.html#commercial-litigation" class="card-link">Learn More &rarr;</a>
          </div>
          <div class="card">
            <h3 class="card-title">Creditors' Rights</h3>
            <p class="card-body">Expertly navigating pre-suit negotiations, in-depth litigation, and post-judgment enforcement to maximize your recovery on unpaid debts and accounts.</p>
            <a href="/practice-areas.html#creditors-rights" class="card-link">Learn More &rarr;</a>
          </div>
          <div class="card">
            <h3 class="card-title">Real Estate Law</h3>
            <p class="card-body">Providing meticulous legal services for commercial and residential real estate transactions, ensuring your closings are handled with precision and care.</p>
            <a href="/practice-areas.html#real-estate" class="card-link">Learn More &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Trust Badges Section -->
    <section class="trust-badge-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Our Professional Affiliations</h2>
          <p class="section-subheading">
            We are proud members of the nation's leading legal and credit organizations, reflecting our commitment to the highest standards of professional excellence.
          </p>
        </div>
        <div class="logo-cloud">
          <img src="/images/placeholders/logo-clla.jpg" alt="Commercial Law League of America Logo" class="logo-item" width="150" height="75">
          <img src="/images/placeholders/logo-narca.jpg" alt="The National Creditors Bar Association Logo" class="logo-item" width="150" height="75">
          <img src="/images/placeholders/logo-alq.jpg" alt="The American Lawyers Quarterly Logo" class="logo-item" width="150" height="75">
          <img src="/images/placeholders/logo-ilcba.jpg" alt="Illinois Creditors Bar Association Logo" class="logo-item" width="150" height="75">
        </div>
      </div>
    </section>

    <!-- 5. CTA Banner Section -->
    <section class="cta-banner-section">
      <div class="container cta-banner-content">
        <h2 class="cta-heading">Take the Next Step to Protect Your Assets</h2>
        <p class="cta-body">
          Don't let unpaid debts impact your business any longer. Contact The CKB Firm today to learn how our focused legal strategies can work for you.
        </p>
        <a href="/contact.html" class="button button-primary">Schedule a Consultation</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* General Section & Container Styles */
  section {
    padding: 4rem 1rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
  }

  .section-heading {
    font-size: 2.5rem;
    color: var(--color-primary, #3D4C5E);
    margin-bottom: 0.5rem;
  }

  .section-subheading {
    font-size: 1.125rem;
    color: var(--color-secondary, #5C5C5C);
    line-height: 1.6;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .button-primary {
    background-color: var(--color-accent, #D9242C);
    color: #FFFFFF;
  }

  .button-primary:hover, .button-primary:focus {
    background-color: #b81e25; /* Darker accent */
    transform: translateY(-2px);
  }

  /* 1. Hero Section */
  .hero-section {
    background-color: var(--color-background, #F2F2F2);
    padding: 4rem 1rem;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .hero-heading {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    color: var(--color-primary, #3D4C5E);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .hero-body {
    font-size: 1.125rem;
    color: var(--color-text, #5A5A5A);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 550px;
  }

  .hero-image-wrapper {
    display: flex;
    justify-content: center;
  }

  .hero-image {
    width: 100%;
    max-width: 600px;
    height: auto;
    object-fit: cover;
  }

  /* 2. Value Proposition Section */
  .value-prop-section {
    background-color: #FFFFFF;
  }

  .three-column-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .column-item h3 {
    font-size: 1.5rem;
    color: var(--color-primary, #3D4C5E);
    margin-bottom: 0.75rem;
  }

  .column-item p {
    color: var(--color-text, #5A5A5A);
    line-height: 1.6;
  }

  /* 3. Practice Areas Overview Section */
  .practice-areas-section {
    background-color: var(--color-background, #F2F2F2);
  }

  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .card {
    background-color: #FFFFFF;
    padding: 2rem;
    border: 1px solid #e0e0e0;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.5rem;
    color: var(--color-primary, #3D4C5E);
    margin-bottom: 1rem;
  }

  .card-body {
    color: var(--color-text, #5A5A5A);
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .card-link {
    color: var(--color-accent, #D9242C);
    text-decoration: none;
    font-weight: bold;
    align-self: flex-start;
  }
  .card-link:hover {
    text-decoration: underline;
  }

  /* 4. Trust Badges Section */
  .trust-badge-section {
    background-color: #FFFFFF;
  }

  .logo-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .logo-item {
    max-width: 150px;
    height: auto;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .logo-item:hover {
    filter: grayscale(0%);
    opacity: 1;
  }

  /* 5. CTA Banner Section */
  .cta-banner-section {
    background-color: var(--color-primary, #3D4C5E);
    color: #FFFFFF;
    text-align: center;
    padding: 5rem 1rem;
  }

  .cta-heading {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #FFFFFF;
  }

  .cta-body {
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto 2rem;
    opacity: 0.9;
  }

  /* Responsive Design */
  @media (min-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
      text-align: left;
    }

    .hero-content {
      order: 1;
    }

    .hero-image-wrapper {
      order: 2;
    }

    .three-column-grid,
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>